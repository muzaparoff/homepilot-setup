# HomePilot server setup — configuration
#
# Do not edit this file. `./setup.sh` copies it to .env and fills in the
# generated secrets. .env is gitignored; this template is not.

# ── Identity ───────────────────────────────────────────────────────────
# Used for file ownership inside the containers. setup.sh fills these from
# `id -u` / `id -g`. On macOS these are usually 501/20.
PUID=501
PGID=20
TZ=UTC

# ── Storage ────────────────────────────────────────────────────────────
# Service configuration and databases.
HOMEPILOT_DATA=./data

# Media root. The layout underneath is deliberately a single tree:
#
#   ${MEDIA_ROOT}/torrents/{tv,movies}    qBittorrent writes here
#   ${MEDIA_ROOT}/media/{tv,movies}       Sonarr/Radarr import to here
#
# Both live on one mount so imports are hardlinks rather than full copies.
# Split them across separate mounts and every import doubles your disk use
# and takes minutes instead of milliseconds. This is the single most common
# way a first *arr setup goes wrong.
MEDIA_ROOT=./data/media

# ── Ports ──────────────────────────────────────────────────────────────
# These match HomePilot's built-in defaults. Change them and you must
# change the matching field in the app too.
DOCKGE_PORT=5001
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
NODE_EXPORTER_PORT=9100
EXPORTER_PORT=9101

# Media module (only used when you run: ./setup.sh --with-media)
QBITTORRENT_PORT=8081
SONARR_PORT=8989
RADARR_PORT=7878
PROWLARR_PORT=9696

# Notifier module (only used when you run: ./setup.sh --with-notifications)
NOTIFIER_PORT=8899

# ── Secrets ────────────────────────────────────────────────────────────
# setup.sh generates all of these. Left blank here on purpose.
#
# The *arr API keys are set BEFORE first boot via each app's
# APP__AUTH__APIKEY override, rather than being read back out afterwards.
# That inversion is what makes the whole setup re-runnable: the wiring
# step already knows every key without scraping a config file.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
QBITTORRENT_PASSWORD=
SONARR_API_KEY=
RADARR_API_KEY=
PROWLARR_API_KEY=

# ── Push notifications (fill in yourself) ───────────────────────────────
# Only read when you run: ./setup.sh --with-notifications
# Nothing here can be generated — it comes from an Apple-issued key.
# See README.md "Push notifications" for the one-time App Store Connect
# steps (create an APNs auth key, download the .p8 once, note the Key ID
# and your Team ID). Put the .p8 at stacks/notifier/apns-key.p8.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=com.homepilot.HomePilot

# ── Runtime (detected) ─────────────────────────────────────────────────
# Written by setup.sh. The socket differs by engine: Docker Desktop,
# OrbStack and Colima use /var/run/docker.sock; Podman uses the in-VM
# path /run/podman/podman.sock.
CONTAINER_SOCK=/var/run/docker.sock
